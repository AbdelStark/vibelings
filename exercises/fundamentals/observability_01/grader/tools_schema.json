{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Document processing tool definitions",
  "tools": [
    {
      "name": "read_document",
      "description": "Read a document from storage",
      "parameters": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Document identifier"
          },
          "format": {
            "type": "string",
            "enum": ["text", "markdown"],
            "description": "Output format"
          }
        },
        "required": ["document_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "summarize_text",
      "description": "Generate a summary using LLM",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Text to summarize"
          },
          "max_length": {
            "type": "integer",
            "minimum": 10,
            "maximum": 1000,
            "description": "Maximum summary length in words"
          }
        },
        "required": ["text"],
        "additionalProperties": false
      }
    },
    {
      "name": "send_message",
      "description": "Send a message to a recipient",
      "parameters": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Recipient identifier"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Message subject"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "description": "Message body"
          }
        },
        "required": ["to", "subject", "body"],
        "additionalProperties": false
      }
    }
  ]
}
