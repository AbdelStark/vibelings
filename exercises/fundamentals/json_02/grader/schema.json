{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Team",
  "description": "A team with members and project information",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "department": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": ["lead", "senior", "junior"]
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["name", "role", "skills"],
        "additionalProperties": false
      }
    },
    "currentProject": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "deadline": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["planning", "active", "review", "complete"]
        }
      },
      "required": ["name", "deadline", "status"],
      "additionalProperties": false
    }
  },
  "required": ["name", "department", "members"],
  "additionalProperties": false
}
