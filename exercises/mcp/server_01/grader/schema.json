{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Tool Definition",
  "description": "Valid MCP tool definition for calculate_area",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "calculate_area"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "A description of what the tool does"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "properties": {
          "type": "object",
          "properties": {
            "shape": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "string"
                },
                "enum": {
                  "type": "array",
                  "items": { "type": "string" },
                  "contains": { "const": "circle" },
                  "minItems": 3,
                  "maxItems": 3
                },
                "description": {
                  "type": "string"
                }
              },
              "required": ["type", "enum"]
            },
            "radius": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "number"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": ["type"]
            },
            "width": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "number"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": ["type"]
            },
            "height": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "number"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": ["type"]
            },
            "base": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "number"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": ["type"]
            }
          },
          "required": ["shape", "radius", "width", "height", "base"]
        },
        "required": {
          "type": "array",
          "contains": { "const": "shape" },
          "minItems": 1
        }
      },
      "required": ["type", "properties", "required"]
    }
  },
  "required": ["name", "description", "inputSchema"],
  "additionalProperties": false
}
