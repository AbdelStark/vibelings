{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Budget Configuration Schema",
  "description": "Schema for validating cost and latency budget configurations",
  "type": "object",
  "required": ["budget_config"],
  "additionalProperties": false,
  "properties": {
    "budget_config": {
      "type": "object",
      "required": ["name", "cost_limits", "latency_slos", "token_limits", "degradation_policy", "monitoring"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cost_limits": {
          "type": "object",
          "required": ["per_request_max_usd", "daily_limit_usd", "monthly_limit_usd"],
          "properties": {
            "per_request_max_usd": {
              "type": "number",
              "minimum": 0
            },
            "daily_limit_usd": {
              "type": "number",
              "minimum": 0
            },
            "monthly_limit_usd": {
              "type": "number",
              "minimum": 0
            },
            "alert_thresholds": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "latency_slos": {
          "type": "object",
          "required": ["p50_ms", "p95_ms", "p99_ms", "timeout_ms"],
          "properties": {
            "p50_ms": {
              "type": "integer",
              "minimum": 1
            },
            "p95_ms": {
              "type": "integer",
              "minimum": 1
            },
            "p99_ms": {
              "type": "integer",
              "minimum": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "token_limits": {
          "type": "object",
          "required": ["max_input_tokens", "max_output_tokens", "max_total_tokens"],
          "properties": {
            "max_input_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_total_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "degradation_policy": {
          "type": "object",
          "required": ["on_cost_warning", "on_latency_warning", "on_limit_reached"],
          "properties": {
            "on_cost_warning": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "on_latency_warning": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "on_limit_reached": {
              "type": "string",
              "enum": ["reject", "queue", "degrade", "fallback"]
            }
          }
        },
        "monitoring": {
          "type": "object",
          "required": ["metrics_to_track", "alert_channels"],
          "properties": {
            "metrics_to_track": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "alert_channels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "dashboard_enabled": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
