{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evaluation Harness Schema",
  "description": "Schema for validating eval harness configurations",
  "type": "object",
  "required": ["eval_harness"],
  "additionalProperties": false,
  "properties": {
    "eval_harness": {
      "type": "object",
      "required": ["name", "agent_under_test", "test_cases", "metrics", "reliability", "regression_detection"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "agent_under_test": {
          "type": "object",
          "required": ["name", "capabilities", "model"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "test_cases": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "input", "expected", "type"],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "input": {
                "type": ["string", "object"]
              },
              "expected": {
                "type": ["string", "object"]
              },
              "type": {
                "type": "string",
                "enum": ["deterministic", "semantic", "behavioral"]
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["name", "type", "threshold", "aggregation"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": ["accuracy", "latency", "cost", "reliability"]
              },
              "threshold": {
                "type": "number"
              },
              "aggregation": {
                "type": "string",
                "enum": ["mean", "median", "p95", "p99", "min", "max"]
              }
            }
          }
        },
        "reliability": {
          "type": "object",
          "required": ["runs_per_case", "pass_threshold", "confidence_interval"],
          "additionalProperties": false,
          "properties": {
            "runs_per_case": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "pass_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "confidence_interval": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "regression_detection": {
          "type": "object",
          "required": ["baseline", "tolerance", "alert_on_degradation"],
          "additionalProperties": false,
          "properties": {
            "baseline": {
              "type": "string",
              "minLength": 1
            },
            "tolerance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "alert_on_degradation": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
