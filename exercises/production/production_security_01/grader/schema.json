{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Security Configuration Schema",
  "description": "Schema for validating prompt injection defense configurations",
  "type": "object",
  "required": ["security_config"],
  "additionalProperties": false,
  "properties": {
    "security_config": {
      "type": "object",
      "required": ["name", "input_validation", "output_filtering", "privilege_separation", "attack_detection", "response_procedures"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input_validation": {
          "type": "object",
          "required": ["max_length", "blocked_patterns", "sanitization_rules"],
          "properties": {
            "max_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "blocked_patterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "sanitization_rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object"
              }
            },
            "encoding_check": {
              "type": "boolean"
            }
          }
        },
        "output_filtering": {
          "type": "object",
          "required": ["action_allowlist"],
          "properties": {
            "blocked_content_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pii_detection": {
              "type": "boolean"
            },
            "credential_detection": {
              "type": "boolean"
            },
            "action_allowlist": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "privilege_separation": {
          "type": "object",
          "required": ["trust_levels", "tool_permissions"],
          "properties": {
            "trust_levels": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["name", "level"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "level": {
                    "type": "integer"
                  }
                }
              }
            },
            "tool_permissions": {
              "type": "object",
              "minProperties": 1
            },
            "data_access_rules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "attack_detection": {
          "type": "object",
          "required": ["patterns", "logging_level"],
          "properties": {
            "patterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "pattern"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "pattern": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": ["low", "medium", "high", "critical"]
                  }
                }
              }
            },
            "anomaly_detection": {
              "type": "boolean"
            },
            "logging_level": {
              "type": "string",
              "enum": ["minimal", "standard", "verbose"]
            }
          }
        },
        "response_procedures": {
          "type": "object",
          "required": ["on_detection"],
          "properties": {
            "on_detection": {
              "type": "string",
              "enum": ["log_only", "warn", "block", "block_and_log", "quarantine"]
            },
            "escalation": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "notify": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "quarantine": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
