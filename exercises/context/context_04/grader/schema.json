{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompactedConversation",
  "description": "A compacted summary of a conversation preserving critical information",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200,
            "description": "What was decided"
          },
          "importance": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200,
            "description": "Why this decision matters for the task"
          },
          "turn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "The turn number where this was decided"
          }
        },
        "required": ["statement", "importance", "turn"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 10
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200,
            "description": "The established fact"
          },
          "relevance": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200,
            "description": "Why this fact is relevant to the task"
          },
          "turn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "The turn number where this was established"
          }
        },
        "required": ["statement", "relevance", "turn"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 10
    },
    "current_state": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500,
      "description": "Description of where the task currently stands"
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      },
      "minItems": 1,
      "maxItems": 10,
      "description": "Unresolved questions or pending actions"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "original_tokens": {
          "type": "integer",
          "minimum": 100,
          "description": "Estimated token count of original conversation"
        },
        "compacted_tokens": {
          "type": "integer",
          "minimum": 50,
          "description": "Estimated token count of this summary"
        }
      },
      "required": ["original_tokens", "compacted_tokens"],
      "additionalProperties": false
    }
  },
  "required": ["decisions", "facts", "current_state", "open_items", "metadata"],
  "additionalProperties": false
}
