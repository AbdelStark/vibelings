{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JustInTimeContextStrategy",
  "description": "A just-in-time context retrieval strategy for an AI agent",
  "type": "object",
  "properties": {
    "initial_context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "description": "Identifier for this context item"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "description": "What this context contains"
          },
          "token_estimate": {
            "type": "integer",
            "minimum": 10,
            "maximum": 2000,
            "description": "Estimated token count"
          }
        },
        "required": ["name", "description", "token_estimate"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 5
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "description": "Identifier for this trigger"
          },
          "pattern": {
            "type": "string",
            "minLength": 3,
            "description": "Regex or keyword pattern that activates this trigger"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Source names to query when triggered"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 50,
            "maximum": 4000,
            "description": "Maximum tokens to retrieve"
          },
          "cache": {
            "type": "boolean",
            "description": "Whether to cache retrieved context"
          }
        },
        "required": ["name", "pattern", "sources", "max_tokens", "cache"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 10
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "description": "Unique identifier for this source"
          },
          "type": {
            "type": "string",
            "enum": ["knowledge_base", "api", "database", "documentation"],
            "description": "Type of context source"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "description": "What this source contains"
          },
          "avg_tokens": {
            "type": "integer",
            "minimum": 50,
            "maximum": 5000,
            "description": "Average tokens per retrieval"
          }
        },
        "required": ["name", "type", "description", "avg_tokens"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 8
    },
    "loading_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "description": "Priority order for querying sources"
    }
  },
  "required": ["initial_context", "triggers", "sources", "loading_order"],
  "additionalProperties": false
}
